# Nova – .gitignore
# Stellt sicher, dass private Daten NICHT ins Git-Repo gelangen

# -----------------------------------------------------------------------
# Private Daten (dürfen NIE ins Repo!)
# -----------------------------------------------------------------------
config.json            # enthält secret_key und API-Schlüssel
*.db                   # SQLite-Datenbanken
*.db-shm               # SQLite WAL Shared Memory
*.db-wal               # SQLite WAL Log
nova_data/             # lokales Datenverzeichnis (falls im Repo-Ordner)
nova_backups/          # Backup-Verzeichnis (falls im Repo-Ordner)
/~/                    # versehentlich angelegtes Tilde-Verzeichnis (BackupManager-Bug)

# -----------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/

# -----------------------------------------------------------------------
# Logs & temporäre Dateien
# -----------------------------------------------------------------------
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------
# IDE
# -----------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
