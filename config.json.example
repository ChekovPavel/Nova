{
  "_comment": "Nova Konfigurationsvorlage – kopiere zu config.json und passe an",
  "_wichtig": "db_path und backup.dir AUSSERHALB des Git-Repos setzen!",
  "_tilde_hinweis": "~ wird von Python (os.path.expanduser) expandiert, aber NICHT von systemd. Im Service absolute Pfade nutzen, z.B. /home/pi/nova_data/nova_data.db",

  "db_path": "~/nova_data/nova_data.db",

  "_secret_key_hinweis": "Generiere mit: openssl rand -hex 32",
  "secret_key": "DEIN_SICHERER_SCHLUESSEL_HIER",

  "stm_capacity": 20,

  "ollama": {
    "_comment": "Lokales LLM via Ollama – empfohlen für Raspberry Pi",
    "host": "http://localhost:11434",
    "model": "llama3.2:1b",
    "_modelle_fuer_pi": [
      "llama3.2:1b  – 700 MB, sehr schnell (empfohlen Pi 4B+ 4GB)",
      "llama3.2:3b  – 2 GB, bessere Qualität (empfohlen Pi 4B+ 8GB)",
      "phi3.5:mini  – 2.2 GB, sehr effizient (Microsoft)",
      "gemma2:2b    – 1.6 GB, Google-Modell"
    ],
    "temperature": 0.7,
    "max_tokens": 512
  },

  "local_stt": {
    "_comment": "Lokales Speech-to-Text via Whisper – kein Cloud-Dienst",
    "whisper_model": "tiny",
    "_whisper_modelle": [
      "tiny  – 39 MB, ~32x Echtzeit auf Pi (empfohlen)",
      "base  – 74 MB, ~16x Echtzeit, bessere Qualität",
      "small – 244 MB, ~8x Echtzeit (nur Pi 4B+ 8GB)"
    ],
    "device": "cpu",
    "compute_type": "int8",
    "language": "de"
  },

  "backup": {
    "_comment": "Backup-Verzeichnis AUSSERHALB des Git-Repos!",
    "enabled": true,
    "dir": "~/nova_backups",
    "max_backups": 30,
    "interval_sec": 3600,
    "_tipp": "Für externes USB-Backup: /media/usb/nova_backups"
  },

  "voice": {
    "enabled": true,
    "language": "de-DE",
    "tts_rate": 160,
    "tts_volume": 0.9
  },

  "api": {
    "_comment": "Externer LLM-Dienst – nur als Fallback, wenn Ollama nicht läuft",
    "enabled": false,
    "llm_endpoint": "https://api.openai.com/v1/chat/completions",
    "llm_api_key": "",
    "llm_model": "gpt-4o-mini"
  }
}
